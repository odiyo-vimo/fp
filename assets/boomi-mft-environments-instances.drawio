-size:17px&quot;&gt;Users&lt;/b&gt;&lt;br&gt;Standard_Admin: lead&lt;br&gt;Standard_User: developers&lt;br&gt;Role-based access" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="810" y="730" width="205" height="170" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style=&quot;font-size:17px&quot;&gt;Machine users&lt;/b&gt;&lt;br&gt;Service and API accounts&lt;br&gt;Trigger flows, upload,&lt;br&gt;pre-signed URLs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1035" y="730" width="205" height="170" as="geometry"/></mxCell><mxCell id="orgnote" value="All scoped to exactly one organization" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#3e4c59;" vertex="1" parent="1"><mxGeometry x="360" y="912" width="880" height="40" as="geometry"/></mxCell><mxCell id="p_tax_dev" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev_tax" target="tst_tax"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_tax_tst" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="tst_tax" target="ppd_tax"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_tax_ppd" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;e