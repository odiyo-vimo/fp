 id="prd_tax" value="&lt;b style=&quot;font-size:17px&quot;&gt;Instance: Tax&lt;/b&gt;&lt;br&gt;Own organizations, endpoints,&lt;br&gt;users, flows and keys" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1230" y="135" width="310" height="110" as="geometry"/></mxCell><mxCell id="prd_voa" value="&lt;b style=&quot;font-size:17px&quot;&gt;Instance: Valuation Office&lt;/b&gt;&lt;br&gt;Own organizations, endpoints,&lt;br&gt;users, flows and keys" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbf1e1;strokeColor=#8a5a00;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1230" y="265" width="310" height="110" as="geometry"/></mxCell><mxCell id="prd_bdt" value="&lt;b style=&quot;font-size:17px&quot;&gt;Instance: Borders and Trade&lt;/b&gt;&lt;br&gt;Own organizations, endpoints,&lt;br&gt;users, flows and keys" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3f3f1;strokeColor=#0f6e66;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1230" y="395" width="310" height="110" as="geometry"/></mxCell><mxCell id="inst" value="&lt;b&gt;Instance: Tax in the development site (the same model applies to all 12 instances)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Logically isolated tenant: cannot see or touch another instance&amp;#x27;s data, configuration or users&lt;/i&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdf2f0;strokeColor=#c2412d;strokeWidth=2.2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=4;fontSize=15;fontColor=#c2412d;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1520" height="410" as="geometry"/></mxCell><mxCell id="org_ptn" value="&lt;b style=&quot;font-size:17px&quot;&gt;Organization&lt;/b&gt;&lt;br&gt;TAX-PTN-&amp;lt;Partner&amp;gt;&lt;br&gt;(collapsed)" style="rounded=1;arcSize=6;whiteS