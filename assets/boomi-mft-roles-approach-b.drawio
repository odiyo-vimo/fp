<mxfile host="app.diagrams.net"><diagram id="boomi-mft-roles-approach-b" name="Boomi MFT roles, Approach B"><mxGraphModel dx="1600" dy="1070" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ipaas" value="&lt;b style=&quot;font-size:17px&quot;&gt;iPaaS platform team&lt;/b&gt;&lt;br&gt;Creates organizations, assigns roles&lt;br&gt;Registers MFT runtimes (D-RA-01)&lt;br&gt;Grants cross-organization access" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf3d6;strokeColor=#7a5a00;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="480" height="120" as="geometry"/></mxCell><mxCell id="approach" value="&lt;b style=&quot;font-size:17px&quot;&gt;Approach B&lt;/b&gt;&lt;br&gt;Each product team gets one organization per instance and environment.&lt;br&gt;Inside it the team creates its own endpoints and flows. It cannot create organizations." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#c5ccd3;strokeWidth=1.2;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="1000" height="120" as="geometry"/></mxCell><mxCell id="inst" value="&lt;b&gt;Instance: Tax (the same model in every instance and environment)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdf2f0;strokeColor=#c2412d;strokeWidth=2.2;dashed=0;verticalAlign=top;align=left;spacingLeft=560;spacingTop=4;fontSize=15;fontColor=#c2412d;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1520" height="760" as="geometry"/></mxCell><mxCell id="org" value="&lt;b&gt;Organization: TAX-PRJ-&amp;lt;Product&amp;gt; (one product team)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7eff7;strokeColor=#7b2d6e;strokeWidth=2.0;dashed=0;verticalAlign=top;align=left;spacingLeft=300;spacingTop=4;fontSize=15;fontColor=#7b2d6e;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="1480" height="560" as="geometry"/></mxCell><mxCell id="srca" value="&lt;b style=&quot;font-size:17px&quot;&gt;Source A&lt;/b&gt;&lt;br&gt;SFTP site (external)&lt;br&gt;Organization endpoint&lt;br&gt;Created by Standard_Admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="280" height="110" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:17px&quot;&gt;iPaaS S3 staging area&lt;/b&gt;&lt;br&gt;S3, internal via MFT Node&lt;br&gt;Organization endpoint&lt;br&gt;Created by Standard_Admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="280" height="110" as="geometry"/></mxCell><mxCell id="dsta" value="&lt;b style=&quot;font-size:17px&quot;&gt;Destination A&lt;/b&gt;&lt;br&gt;Organization endpoint&lt;br&gt;Created by Standard_Admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="260" height="100" as="geometry"/></mxCell><mxCell id="dstb" value="&lt;b style=&quot;font-size:17px&quot;&gt;Destination B&lt;/b&gt;&lt;br&gt;Organization endpoint&lt;br&gt;Created by Standard_Admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="keys" value="&lt;b style=&quot;font-size:17px&quot;&gt;Keys and certificates&lt;/b&gt;&lt;br&gt;PGP, SSH, TLS&lt;br&gt;Standard_Admin (D-RA-02)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1260" y="350" width="260" height="100" as="geometry"/></mxCell><mxCell id="alerts" value="&lt;b style=&quot;font-size:17px&quot;&gt;Alerts and activity&lt;/b&gt;&lt;br&gt;File activity and alerts&lt;br&gt;Both roles view and act" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b3a8c;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1260" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="flownote" value="Flows 1 to 3 and their flow endpoints are created by Standard_User, using the organization&#x27;s endpoints" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#3e4c59;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="1120" height="30" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b style=&quot;font-size:17px&quot;&gt;Standard_Admin (administrator)&lt;/b&gt;&lt;br&gt;Product or project lead or owner&lt;br&gt;Creates and maintains organization endpoints&lt;br&gt;Everything Standard_User can do" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="100" y="665" width="420" height="150" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b style=&quot;font-size:17px&quot;&gt;Standard_User (developer)&lt;/b&gt;&lt;br&gt;Developers in the product team&lt;br&gt;Creates flows using organization endpoints&lt;br&gt;Views alerts and file activity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="560" y="665" width="420" height="150" as="geometry"/></mxCell><mxCell id="mach" value="&lt;b style=&quot;font-size:17px&quot;&gt;Machine user (service account)&lt;/b&gt;&lt;br&gt;Not a person; one per integration&lt;br&gt;Triggers flows and uploads files&lt;br&gt;Requests pre-signed URLs through the API" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1020" y="665" width="500" height="150" as="geometry"/></mxCell><mxCell id="others" value="&lt;b style=&quot;font-size:17px&quot;&gt;Other organizations in this instance&lt;/b&gt;&lt;br&gt;No access unless the iPaaS team grants it on a need basis (D-RA-04)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8f99a3;strokeWidth=1.6;dashed=1;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1480" height="70" as="geometry"/></mxCell><mxCell id="assign" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1486;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ipaas" target="org"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="assign_lbl" value="Creates organization, assigns roles" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="292" y="232" width="261" height="26" as="geometry"/></mxCell><mxCell id="f1" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="srca" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1_lbl" value="Flow 1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="419" y="422" width="61" height="26" as="geometry"/></mxCell><mxCell id="f2" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.3636;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="dsta"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="420"/><mxPoint x="850" y="400"/></Array></mxGeometry></mxCell><mxCell id="f2_lbl" value="Flow 2" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="871" y="387" width="61" height="26" as="geometry"/></mxCell><mxCell id="f3" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.6364;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="dstb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="450"/><mxPoint x="850" y="540"/></Array></mxGeometry></mxCell><mxCell id="f3_lbl" value="Flow 3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa5b1;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="871" y="527" width="61" height="26" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Organization endpoint, Role or account, Platform team (colour keys as drawn). Arrows inside the organization are flows. Endpoint, flow and account names follow the naming conventions in section 8." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#c5ccd3;align=left;spacingLeft=14;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="1520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>