" height="64" as="geometry" /></mxCell><mxCell id="p2-td-42" value="28/01/2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f2f1;strokeColor=#b1b4b6;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#0b0c0c;spacingLeft=10;" vertex="1" parent="p2-1"><mxGeometry x="960" y="484" width="100" height="64" as="geometry" /></mxCell><mxCell id="p2-footbar-43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1d70b8;strokeColor=#1d70b8;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#0b0c0c;spacingLeft=10;" vertex="1" parent="p2-1"><mxGeometry x="0" y="582" width="1100" height="6" as="geometry" /></mxCell><mxCell id="p2-foot-44" value="Help&amp;nbsp;&amp;nbsp;&amp;nbsp;Privacy&amp;nbsp;&amp;nbsp;&amp;nbsp;Cookies&amp;#10;&amp;#10;OGL&amp;nbsp;&amp;nbsp;All content is available under the Open Government Licence v3.0 except where otherwise stated.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#169; Crown copyright" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f2f1;strokeColor=#f3f2f1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#0b0c0c;spacingLeft=40;" vertex="1" parent="p2-1"><mxGeometry x="0" y="588" width="1100" height="78" as="geometry" /></mxCell><mxCell id="p2-note-45" value="Open decisions on this screen&amp;#10;&amp;#10;D-TC-01  Last Run is empty on every visible row and was partially cut off by the screen edge.&amp;#10;D-TC-02  Created timestamps are truncated in the source. Rows 3 and 4 show the date only.&amp;#10;D-TC-03  Only four rows were visible. Confirm whether pagination or scrolling is required.&amp;#10;D-TC-04  Confirm the Source and Destination display format is intended, not a concatenation artefact.&amp;#10;D-AP-01  Flow ID values on the approvals screen are placeholders." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7bf;strokeColor=#f47738;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#0b0c0c;spacingLeft=14;" vertex="1" parent="p2-1"><mxGeometry x="40" y="694" width="1020" height="118" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ftr-p3" name="Dashboard"><mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="p3-0" /><mxCell id="p3-1" parent="p3-0" /><mxCell id="p3-hdr-1" value="GOV.UK   Managed File Transfer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#12436d;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#ffffff;spacingLeft=40;" vertex="1" parent="p3-1"><mxGeometry x="0" y="0" width="1100" height="50" as="geometry" /></mxCell><mxCell id="p3-h1-2" value="Dashboard" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#0b0c0c;spacingLeft=0;" vertex="1" parent="p3-1"><mxGeometry x="40" y="84" width="760" height="44" as="geometry" /></mxCell><mxCell id="p3-h2-3" value="Manage File Transfers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontStyle=0;fontColor=#0b0c0c;spacingLeft=0;" vertex="1" parent="p3-1"><mxGeometry x="40" y="134" width="500" height="26" as="geometry" /></mxCell><mxCell id="p3-summary-4" value="This is the entry point for managing file transfers on the platform. From here you can browse what is already configured, move an approved configuration through to the next environment, and clear the approvals queue that gates those moves. The three cards below follow the lifecycle in order: see what exists, promote a change, then approve it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f2f1;strokeColor=#b1b4b6;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#0b0c0c;spacingLeft=16;" vertex="1" parent="p3-1"><mxGeometry x="40" y="172" width="1020" height="74" as="geometry" /></mxCell><mxCell id="p3-cardtitle-5" value="MFT Transfer Catalog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b4b6;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#0b0c0c;spacingLeft=16;" vertex="1" parent="p3-1"><mxGeometry x="40" y="286" width="320" height="78" as="geometry" /></mxCell><mxCell id="p3-cardbody-6" value="&amp;#10;&amp;#10;&amp;#10;Browse existing scheduled file transfer configurations. Each entry shows its source, destination, schedule and when it last ran." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2ebe8;strokeColor=#b1b4b6;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#0b0c0c;spacingLeft=16;" vertex="1" parent="p3-1"><mxGeometry x="40" y="364" width="320" height="168" as="geometry" /></mxCell><mxCell id="p3-cardlink-7" value="Transfer Catalog" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#4c2c92;spacingLeft=10;" vertex="1" parent="p3-1"><mxGeometry x="46" y="374" width="308" height="22" as="geometry" /></mxCell><mxCell id="p3-cardtitle-8" value="MFT Flow Promotion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b4b6;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontStyle=1;fontColor=#0b0c0c;spacingLeft=16;" vertex="1" parent="p3-1"><mxGeometry x="390" y="286" width="320" height="78" as="geometry" /></mxCell><mxCell id="p3-cardbody-9" value="&amp;#10;&amp;#10;&amp;#10;Move an approved transfer configuration from one environment to the next. Raises the promotion request and tracks it through to release." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2ebe8;strokeColor=#b1b4b6;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#0b0c0c;spacingLeft=16;" vertex="1" parent="p3-1"><