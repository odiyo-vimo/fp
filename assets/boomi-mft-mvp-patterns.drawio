<mxfile host="app.diagrams.net"><diagram id="mvp4" name="MVP four patterns"><mxGraphModel dx="1000" dy="770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="790" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_ext" value="&lt;b&gt;External: Pega Cloud SaaS landing zones&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f4eef8;strokeColor=#7b3fa0;fontColor=#7b3fa0;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="960" height="130" as="geometry"/></mxCell><mxCell id="z_boomi" value="&lt;b&gt;Boomi-hosted&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#eef3f8;strokeColor=#1d4e89;fontColor=#1d4e89;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="960" height="110" as="geometry"/></mxCell><mxCell id="z_int" value="&lt;b&gt;Internal AWS boundary (non-production)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#eef6f0;strokeColor=#1e6b3a;fontColor=#1e6b3a;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="960" height="290" as="geometry"/></mxCell><mxCell id="lz1" value="&lt;b&gt;Pega LZ 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#52606d&quot;&gt;SFTP (to confirm)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="57" width="170" height="56" as="geometry"/></mxCell><mxCell id="lz2" value="&lt;b&gt;Pega LZ 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#52606d&quot;&gt;SFTP (to confirm)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;fontSize=13;" vertex="1"