<mxfile host="app.diagrams.net"><diagram id="sdec-checksum" name="SDEC document checksum"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1300" pageHeight="1889" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Integration Flow -&lt;br&gt;Checksum match" style="shape=umlFrame;whiteSpace=wrap;html=1;width=220;height=42;fillColor=#fff2cc;strokeColor=#c9a879;fontColor=#5c4a1e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1220" height="764" as="geometry"/></mxCell><mxCell id="c3" value="Integration Flow -&lt;br&gt;Checksum mismatch" style="shape=umlFrame;whiteSpace=wrap;html=1;width=220;height=42;fillColor=#fff2cc;strokeColor=#c9a879;fontColor=#5c4a1e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="1220" height="491" as="geometry"/></mxCell><mxCell id="c4" value="Re-try" style="shape=umlFrame;whiteSpace=wrap;html=1;width=92;height=27;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a2b28;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1126" width="820" height="229" as="geometry"/></mxCell><mxCell id="c5" value="Integration Flow -&lt;br&gt;Onward transfer to NRS" style="shape=umlFrame;whiteSpace=wrap;html=1;width=220;height=42;fillColor=#fff2cc;strokeColor=#c9a879;fontColor=#5c4a1e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1401" width="1220" height="454" as="geometry"/></mxCell><mxCell id="c6" value="SDEC Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="24" width="170" height="1857" as="geometry"/></mxCell><mxCell id="c7" value="SDEC Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;size=56;fillColor=#f9dcc4;strokeColor=#d99a62;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="24" width="170" height="1857" as="geometry"/></mxCell><mxCell id="c8" value="iPaaS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;size=56;fillColor=#c9d6e2;strokeColor=#7f98ad;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="675" y="24" width="170" height="1857" as="geometry"/></mxCell><mxCell id="c9" value="NRS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;size=56;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="965" y="24" width="170" height="1857" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="172" as="sourcePoint"/><mxPoint x="152" y="210" as="targetPoint"/><Array as="points"><mxPoint x="180" y="172"/><mxPoint x="180" y="210"/></Array></mxGeometry></mxCell><mxCell id="c11" value="1. Read the file in chunks and&lt;br&gt;compute SHA-256 (streaming)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="190" y="166" width="207" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="256" as="sourcePoint"/><mxPoint x="450" y="256" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="2. Document metadata + checksumSha256" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="174" y="232" width="252" height="18" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="320" as="sourcePoint"/><mxPoint x="760" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="3. POST /generate_presignedurl with&lt;br&gt;documents[].checksumSha256" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="485" y="280" width="240" height="34" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="350" as="sourcePoint"/><mxPoint x="762" y="404" as="targetPoint"/><Array as="points"><mxPoint x="790" y="350"/><mxPoint x="790" y="404"/></Array></mxGeometry></mxCell><mxCell id="c17" value="4. Register fileId, store expected&lt;br&gt;digest, sign URL bound to fileId,&lt;br&gt;size and digest" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="344" width="233" height="50" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="466" as="sourcePoint"/><mxPoint x="450" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="5. 201 upload.url + requiredHeaders&lt;br&gt;(Content-Digest, X-External-Document-ID)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="469" y="426" width="272" height="34" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="514" as="sourcePoint"/><mxPoint x="150" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="6. Presigned URL and header values" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="184" y="490" width="233" height="18" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="562" as="sourcePoint"/><mxPoint x="760" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. PUT /uploads/{fileId} with Content-Digest: sha-256=:&amp;lt;Base64&amp;gt;:" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="241" y="538" width="428" height="18" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="592" as="sourcePoint"/><mxPoint x="762" y="646" as="targetPoint"/><Array as="points"><mxPoint x="790" y="592"/><mxPoint x="790" y="646"/></Array></mxGeometry></mxCell><mxCell id="c25" value="8. Verify URL signature; header&lt;br&gt;digest must equal the registered&lt;br&gt;digest" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="586" width="220" height="50" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="674" as="sourcePoint"/><mxPoint x="762" y="712" as="targetPoint"/><Array as="points"><mxPoint x="790" y="674"/><mxPoint x="790" y="712"/></Array></mxGeometry></mxCell><mxCell id="c27" value="9. Stream bytes to /inbound and hash&lt;br&gt;while writing" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="668" width="246" height="34" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="740" as="sourcePoint"/><mxPoint x="762" y="794" as="targetPoint"/><Array as="points"><mxPoint x="790" y="740"/><mxPoint x="790" y="794"/></Array></mxGeometry></mxCell><mxCell id="c29" value="10. Computed = expected: status&lt;br&gt;UPLOADED, event&lt;br&gt;file_upload_received, start AV scan" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="734" width="240" height="50" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="840" as="sourcePoint"/><mxPoint x="150" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="11. 201 Created (bytes received intact)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="322" y="816" width="266" height="18" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="972" as="sourcePoint"/><mxPoint x="760" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="12. PUT /uploads/{fileId} (bytes altered or truncated on the way)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="238" y="948" width="434" height="18" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1002" as="sourcePoint"/><mxPoint x="762" y="1056" as="targetPoint"/><Array as="points"><mxPoint x="790" y="1002"/><mxPoint x="790" y="1056"/></Array></mxGeometry></mxCell><mxCell id="c35" value="13. Computed differs from expected:&lt;br&gt;discard file, never released&lt;br&gt;downstream" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="996" width="240" height="50" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1102" as="sourcePoint"/><mxPoint x="150" y="1102" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="14. 422 Problem: Content-Digest mismatch" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="319" y="1078" width="272" height="18" as="geometry"/></mxCell><mxCell id="c38" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1173" as="sourcePoint"/><mxPoint x="152" y="1227" as="targetPoint"/><Array as="points"><mxPoint x="180" y="1173"/><mxPoint x="180" y="1227"/></Array></mxGeometry></mxCell><mxCell id="c39" value="15. Recompute SHA-256. If it differs&lt;br&gt;from step 2, the file changed:&lt;br&gt;request a new URL" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="190" y="1167" width="246" height="50" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1273" as="sourcePoint"/><mxPoint x="760" y="1273" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="16. PUT again with the same URL (while not expired)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="283" y="1249" width="344" height="18" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1321" as="sourcePoint"/><mxPoint x="150" y="1321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="17. 201 Created, or 410 URL_EXPIRED (request a new URL)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="1297" width="370" height="18" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="1481" as="sourcePoint"/><mxPoint x="1050" y="1481" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="18. NRS attachment request via iPaaS proxy, with the same checksumSha256" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="510" y="1457" width="480" height="18" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="1529" as="sourcePoint"/><mxPoint x="450" y="1529" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="19. NRS presigned upload URL" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="653" y="1505" width="194" height="18" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1559" as="sourcePoint"/><mxPoint x="762" y="1613" as="targetPoint"/><Array as="points"><mxPoint x="790" y="1559"/><mxPoint x="790" y="1613"/></Array></mxGeometry></mxCell><mxCell id="c49" value="20. Re-hash the file from transient&lt;br&gt;storage and compare with the&lt;br&gt;registered digest" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="1553" width="240" height="50" as="geometry"/></mxCell><mxCell id="c50" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1675" as="sourcePoint"/><mxPoint x="1050" y="1675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="21. PUT file to the NRS URL with&lt;br&gt;Content-Digest" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="795" y="1635" width="220" height="34" as="geometry"/></mxCell><mxCell id="c52" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="1705" as="sourcePoint"/><mxPoint x="1052" y="1775" as="targetPoint"/><Array as="points"><mxPoint x="1080" y="1705"/><mxPoint x="1080" y="1775"/></Array></mxGeometry></mxCell><mxCell id="c53" value="22. Verify digest&lt;br&gt;against checksumSha256&lt;br&gt;from the attachment&lt;br&gt;request" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacing=0;" vertex="1" parent="1"><mxGeometry x="1090" y="1699" width="155" height="66" as="geometry"/></mxCell><mxCell id="c54" value="" style="html=1;rounded=0;strokeColor=#333333;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="1821" as="sourcePoint"/><mxPoint x="760" y="1821" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="23. 201 Created (delivered intact)" style="text;html=1;align=center;verticalAlign=top;fontSize=12;spacing=0;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="788" y="1797" width="233" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>