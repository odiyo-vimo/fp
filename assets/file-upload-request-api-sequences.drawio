ometry"/></mxCell><mxCell id="c82" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4A5968;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1182.9" y="1518.0" as="sourcePoint"/><mxPoint x="119.0" y="1518.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="3. 200 OK, ETag (403 if expired, 400 if checksum&lt;br&gt;differs)" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#4A5968;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="520.6" y="1484.0" width="266.7" height="32.0" as="geometry"/></mxCell><mxCell id="c84" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#B4531A;strokeWidth=2.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="119.0" y="1619.0" as="sourcePoint"/><mxPoint x="1182.9" y="1619.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c85" value="4. PUT parts[n].url with part bytes" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="562.1" y="1600.0" width="183.8" height="17.0" as="geometry"/></mxCell><mxCell id="c86" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4A5968;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1182.9" y="1660.0" as="sourcePoint"/><mxPoint x="119.0" y="1660.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c87" value="5. 200 OK, ETag for part n" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#4A5968;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="581.3" y="1641.0" width="145.3" height="17.0" as="geometry"/></mxCell><mxCell id="c88" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;round