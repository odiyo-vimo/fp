ial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#1F5E8C;fontSize=12;fontColor=#1E2A38;" vertex="1" parent="1"><mxGeometry x="663.2" y="1120.0" width="158" height="44" as="geometry"/></mxCell><mxCell id="c64" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#8A97A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1091.6" y="1164.0" as="sourcePoint"/><mxPoint x="1091.6" y="2196.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;Upload Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4A5968&quot;&gt;(database)&lt;/font&gt;" style="fontFamily=Arial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#1F5E8C;fontSize=12;fontColor=#1E2A38;" vertex="1" parent="1"><mxGeometry x="1012.6" y="1120.0" width="158" height="44" as="geometry"/></mxCell><mxCell id="c66" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#8A97A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1281.6" y="1164.0" as="sourcePoint"/><mxPoint x="1281.6" y="2196.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" value="&lt;b&gt;Boomi MFT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4A5968&quot;&gt;SFTP server and flow&lt;/font&gt;" style="fontFamily=Arial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#1F5E8C;fontSize=12;fontColor=#1E2A38;" vertex="1" parent="1"><mxGeometry x="1202.6" y="1120.0" width="158" height="44" as="geometry"/></mxCell><mxCell id="c68" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#8A97A6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1471.6" y="1164.0" as="sourcePoint"/><mxPoint x="1471.6" y="2196.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="&lt;b&gt;Boomi Event&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4A5968&quot;&gt;Streams&lt;/font&gt;" style="fontFamily=Arial;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6EEF5;strokeColor=#1F5E8C;fontSize=12;fontColor=#1E2A38;" vertex="1" parent="1"><mxGeometry x="1392.6" y="1120.0" width="158" height="44" as="geometry"/></mxCell><mxCell id="c70" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#B4531A;strokeWidth=2.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="119.0" y="1228.0" as="sourcePoint"/><mxPoint x="407.7" y="1228.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value="1. PUT /uploads/{fileId}?expires&amp;amp;kid&amp;amp;sig +&lt;br&gt;X-External-Document-ID, Content-Digest, bytes" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="137.0" y="1194.0" width="258.7" height="32.0" as="geometry"/></mxCell><mxCell id="c72" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="407.7" y="1254.0" as="sourcePoint"/><mxPoint x="409.7" y="1304.0" as="targetPoint"/><Array as="points"><mxPoint x="441.7" y="1254.0"/><mxPoint x="441.7" y="1304.0"/></Array></mxGeometry></mxCell><mxCell id="c73" value="2. No OAuth on this route; TLS, quota, max body 100&lt;br&gt;MiB" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="451.7" y="1254.0" width="288.5" height="32.0" as="geometry"/></mxCell><mxCell id="c74" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#B4531A;strokeWidth=2.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="407.7" y="1337.0" as="sourcePoint"/><mxPoint x="742.2" y="1337.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c75" value="3. Stream request to P02" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="508.3" y="1318.0" width="139.3" height="17.0" as="geometry"/></mxCell><mxCell id="c76" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1378.0" as="sourcePoint"/><mxPoint x="1091.6" y="1378.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value="4. Read file row by fileId" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="852.9" y="1359.0" width="134.0" height="17.0" as="geometry"/></mxCell><mxCell id="c78" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4A5968;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1091.6" y="1419.0" as="sourcePoint"/><mxPoint x="742.2" y="1419.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c79" value="5. externalDocumentId, size, SHA-256, status" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#4A5968;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="795.5" y="1400.0" width="248.7" height="17.0" as="geometry"/></mxCell><mxCell id="c80" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1445.0" as="sourcePoint"/><mxPoint x="744.2" y="1495.0" as="targetPoint"/><Array as="points"><mxPoint x="776.2" y="1445.0"/><mxPoint x="776.2" y="1495.0"/></Array></mxGeometry></mxCell><mxCell id="c81" value="6. Header document ID present and equal; verify HMAC&lt;br&gt;and expiry" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="786.2" y="1445.0" width="303.4" height="32.0" as="geometry"/></mxCell><mxCell id="c82" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1573.0" as="sourcePoint"/><mxPoint x="1091.6" y="1573.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="7. Conditional update URL_ISSUED to UPLOADING&lt;br&gt;(single use)" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="777.2" y="1539.0" width="285.4" height="32.0" as="geometry"/></mxCell><mxCell id="c84" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1599.0" as="sourcePoint"/><mxPoint x="744.2" y="1649.0" as="targetPoint"/><Array as="points"><mxPoint x="776.2" y="1599.0"/><mxPoint x="776.2" y="1649.0"/></Array></mxGeometry></mxCell><mxCell id="c85" value="8. SHA-256 of body equals signed checksum and&lt;br&gt;Content-Digest" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="786.2" y="1599.0" width="268.8" height="32.0" as="geometry"/></mxCell><mxCell id="c86" value="" style="endArrow=open;endFill=0;html=1;strokeColor=#B4531A;strokeWidth=2.4;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1712.0" as="sourcePoint"/><mxPoint x="1281.6" y="1712.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c87" value="9. SFTP Write /inbound/{sourceSystem}/{fileId}.bin" style="fontFamily=Arial;text;html=1;ali