.5" y="1816.0" width="178.8" height="17.0" as="geometry"/></mxCell><mxCell id="c94" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4A5968;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1876.0" as="sourcePoint"/><mxPoint x="407.7" y="1876.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c95" value="13. 201 status UPLOADED" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#4A5968;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="502.6" y="1857.0" width="150.7" height="17.0" as="geometry"/></mxCell><mxCell id="c96" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1E2A38;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="1947.0" as="sourcePoint"/><mxPoint x="1091.6" y="1947.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c97" value="14. Reset to URL_ISSUED (retry allowed until expiry)" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#1E2A38;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="775.2" y="1928.0" width="289.4" height="17.0" as="geometry"/></mxCell><mxCell id="c98" value="" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4A5968;strokeWidth=1.3;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="742.2" y="2003.0" as="sourcePoint"/><mxPoint x="407.7" y="2003.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c99" value="15. 422 CHECKSUM_MISMATCH or 502&lt;br&gt;MFT_WRITE_FAILED" style="fontFamily=Arial;text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontSize=12;fontColor=#4A5968;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="465.4" y="1969.0" width="225.2" height="32.0" as="geometry"/></mxCell><mxCell id="c100" value="" style="endArrow=open;endF