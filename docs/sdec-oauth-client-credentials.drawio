<mxfile host="app.diagrams.net"><diagram id="sdec-oauth" name="SDEC OAuth client credentials"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="980" pageHeight="812" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;SDEC backend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#52606d&quot;&gt;Thread Manager / HTTP service&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;recursiveResize=0;size=56;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f5f7fa;strokeColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="16.0" y="18" width="200" height="744" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Authorisation server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#52606d&quot;&gt;OAuth 2.0 token endpoint&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;recursiveResize=0;size=56;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#e8f0fa;strokeColor=#1d4e89;fontColor=#1d4e89;" vertex="1" parent="1"><mxGeometry x="252.0" y="18" width="200" height="744" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Boomi API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#52606d&quot;&gt;Policy enforcement point&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;recursiveResize=0;size=56;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#e8f0fa;strokeColor=#1d4e89;fontColor=#1d4e89;" vertex="1" parent="1"><mxGeometry x="488.0" y="18" width="200" height="744" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Boomi iPaaS / HIP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#52606d&quot;&gt;API process, MFT, NRS proxy&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;recursiveResize=0;size=56;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fontSize=13;fillColor=#f5f7fa;strokeColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="724.0" y="18" width="200" height="744" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;1. POST /oauth2/token&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606d&quot;&gt;client_id:secret (HTTP Basic), grant_type, scope&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116" y="146" as="sourcePoint"/><mxPoint x="352" y="146" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="n8" value="2. Authenticate client, check&lt;br&gt;permitted scopes, sign JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf8e6;strokeColor=#c9a227;fontSize=11;" vertex="1" parent="1"><mxGeometry x="236.0" y="168" width="232" height="42" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;3. 200 OK&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606d&quot;&gt;access_token (JWT), token_type=Bearer, expires_in&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="352" y="274" as="sourcePoint"/><mxPoint x="116" y="274" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="n10" value="4. Cache token in memory;&lt;br&gt;renew shortly before expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf8e6;strokeColor=#c9a227;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0.0" y="296" width="232" height="42" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;5. API call: Authorization: Bearer &amp;lt;access_token&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606d&quot;&gt;Idempotency-Key, X-Correlation-ID, JSON body&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116" y="402" as="sourcePoint"/><mxPoint x="588" y="402" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="n12" value="6. Validate JWT: JWKS signature,&lt;br&gt;iss, aud, exp, scope, client_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf8e6;strokeColor=#c9a227;fontSize=11;" vertex="1" parent="1"><mxGeometry x="472.0" y="424" width="232" height="42" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;7. Forward request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606d&quot;&gt;client identity + correlation ID&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588" y="530" as="sourcePoint"/><mxPoint x="824" y="530" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;8. Response&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606d&quot;&gt;201 / 200 / 202 or Problem&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="824" y="594" as="sourcePoint"/><mxPoint x="588" y="594" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="n15" value="&lt;b&gt;9. Response to SDEC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606d&quot;&gt;or 401 invalid_token / 403 insufficient_scope&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588" y="658" as="sourcePoint"/><mxPoint x="116" y="658" as="targetPoint"/><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="n16" value="alt  401 invalid_token" style="shape=umlFrame;whiteSpace=wrap;html=1;width=150;height=24;strokeColor=#b3401a;fillColor=#fcebe5;fontColor=#b3401a;fontStyle=1;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="16" y="684" width="672" height="62" as="geometry"/></mxCell><mxCell id="n17" value="Discard cached token, request a new one once (step 1), then retry the call. 403: do not retry." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="26" y="712" width="652" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>