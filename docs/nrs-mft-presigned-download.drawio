<mxfile host="app.diagrams.net" type="device"><diagram id="nrs-mft-presigned" name="Sequence"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1552.0" pageHeight="1946.4" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;1.  File lands in Boomi MFT (existing inbound pattern)&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEF1F4;strokeColor=#EEF1F4;strokeWidth=0.56;fontColor=#1F2933;fontSize=11.1;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="178.4" width="1496.0" height="24.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2.  NRS authenticates to the MFT Files API&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEF1F4;strokeColor=#EEF1F4;strokeWidth=0.56;fontColor=#1F2933;fontSize=11.1;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="369.5" width="1496.0" height="24.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3.  Request a short-lived pre-signed download token   (authenticated, privilege: File Download)&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEF1F4;strokeColor=#EEF1F4;strokeWidth=0.56;fontColor=#1F2933;fontSize=11.1;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="498.6" width="1496.0" height="24.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4.  Anonymous download, streamed straight into an S3 multipart upload   (no S3 pre-signed URLs needed)&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEF1F4;strokeColor=#EEF1F4;strokeWidth=0.56;fontColor=#1F2933;fontSize=11.1;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="725.2" width="1496.0" height="24.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5.  Error handling on token redemption (step 9 / 13)&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEF1F4;strokeColor=#EEF1F4;strokeWidth=0.56;fontColor=#1F2933;fontSize=11.1;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="1330.0" width="1496.0" height="24.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=#7B8794;strokeWidth=1.11;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="876.0" y="944.3" width="360.0" height="104.2" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;loop&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#7B8794;strokeColor=#7B8794;strokeWidth=1.11;fontColor=#FFFFFF;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="876.0" y="944.3" width="44.0" height="17.6" as="geometry"/></mxCell><mxCell id="c9" value="&lt;i&gt;[ for each 100 MiB part buffered from the stream ]&lt;/i&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="925.6" y="945.1" width="304.0" height="16.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=#7B8794;strokeWidth=1.11;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="372.0" y="1066.8" width="576.0" height="116.3" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;opt&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#7B8794;strokeColor=#7B8794;strokeWidth=1.11;fontColor=#FFFFFF;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="372.0" y="1066.8" width="44.0" height="17.6" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i&gt;[ stream interrupted, token not expired or exhausted ]&lt;/i&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="421.6" y="1067.6" width="520.0" height="16.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=#7B8794;strokeWidth=1.11;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="372.0" y="1368.4" width="576.0" height="234.1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;alt&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#7B8794;strokeColor=#7B8794;strokeWidth=1.11;fontColor=#FFFFFF;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="372.0" y="1368.4" width="44.0" height="17.6" as="geometry"/></mxCell><mxCell id="c15" value="&lt;i&gt;[ 400 ]&lt;/i&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="421.6" y="1369.2" width="520.0" height="16.0" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#7B8794;strokeWidth=0.83;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372.0" y="1447.0" as="sourcePoint"/><mxPoint x="948.0" y="1447.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;i&gt;[ 404 ]&lt;/i&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380.0" y="1449.4" width="560.0" height="16.0" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#7B8794;strokeWidth=0.83;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372.0" y="1524.0" as="sourcePoint"/><mxPoint x="948.0" y="1524.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="&lt;i&gt;[ 409 ]&lt;/i&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380.0" y="1526.4" width="560.0" height="16.0" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#9AA5B1;strokeWidth=1.11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136.0" y="152.0" as="sourcePoint"/><mxPoint x="136.0" y="1629.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#9AA5B1;strokeWidth=1.11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="152.0" as="sourcePoint"/><mxPoint x="480.0" y="1629.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#9AA5B1;strokeWidth=1.11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="152.0" as="sourcePoint"/><mxPoint x="912.0" y="1629.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#9AA5B1;strokeWidth=1.11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="152.0" as="sourcePoint"/><mxPoint x="1200.0" y="1629.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#9AA5B1;strokeWidth=1.11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420.0" y="152.0" as="sourcePoint"/><mxPoint x="1420.0" y="1629.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Stores the file and assigns&lt;br&gt;a fileReferenceId" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;strokeWidth=0.83;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380.0" y="265.0" width="200.0" height="34.0" as="geometry"/></mxCell><mxCell id="c26" value="Checks caller holds File Download&lt;br&gt;privilege; mints a time- and&lt;br&gt;use-limited token" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;strokeWidth=0.83;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380.0" y="621.4" width="200.0" height="45.3" as="geometry"/></mxCell><mxCell id="c27" value="Verify SHA-256 of the stored object&lt;br&gt;against the SDEC-supplied checksum" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;strokeWidth=0.83;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="804.0" y="1273.7" width="216.0" height="34.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Parameter reference&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;POST&amp;nbsp;/api/Files/1.0/{fileReferenceId}/presigned&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Auth:&amp;nbsp;ApiKey&amp;nbsp;|&amp;nbsp;OAuth2&amp;nbsp;|&amp;nbsp;Bearer&amp;nbsp;&amp;nbsp;&amp;nbsp;Privilege:&amp;nbsp;File&amp;nbsp;Download&lt;br&gt;&amp;nbsp;&amp;nbsp;path&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fileReferenceId&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;required&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Identifier&amp;nbsp;of&amp;nbsp;the&amp;nbsp;file&amp;nbsp;to&amp;nbsp;expose&lt;br&gt;&amp;nbsp;&amp;nbsp;header&amp;nbsp;&amp;nbsp;&amp;nbsp;ThruApplication&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;optional&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Calling&amp;nbsp;application&amp;nbsp;name,&amp;nbsp;recorded&amp;nbsp;for&amp;nbsp;tracing&lt;br&gt;&amp;nbsp;&amp;nbsp;header&amp;nbsp;&amp;nbsp;&amp;nbsp;X-Thru-Tracking-ThruNodeId&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;optional&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Originating&amp;nbsp;MFT&amp;nbsp;node,&amp;nbsp;recorded&amp;nbsp;for&amp;nbsp;tracing&lt;br&gt;&amp;nbsp;&amp;nbsp;body&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;endpointPath&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;string&amp;nbsp;or&amp;nbsp;null&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Flow&amp;nbsp;endpoint&amp;nbsp;path:&amp;nbsp;/{customerCode}/{flow}/{flowEndpoint}&lt;br&gt;&amp;nbsp;&amp;nbsp;body&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;maxDownloads&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;int32,&amp;nbsp;1&amp;nbsp;to&amp;nbsp;10&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Times&amp;nbsp;the&amp;nbsp;token&amp;nbsp;may&amp;nbsp;be&amp;nbsp;redeemed&lt;br&gt;&amp;nbsp;&amp;nbsp;body&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;activeDuration&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;int32,&amp;nbsp;1&amp;nbsp;to&amp;nbsp;86400&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Token&amp;nbsp;lifetime&amp;nbsp;in&amp;nbsp;seconds&amp;nbsp;from&amp;nbsp;issue&amp;nbsp;(max&amp;nbsp;24&amp;nbsp;h)&lt;br&gt;&amp;nbsp;&amp;nbsp;returns&amp;nbsp;&amp;nbsp;200&amp;nbsp;&amp;nbsp;{&amp;nbsp;&amp;quot;presignedUrl&amp;quot;:&amp;nbsp;&amp;quot;&amp;lt;token&amp;gt;&amp;quot;&amp;nbsp;}&lt;br&gt;&lt;br&gt;GET&amp;nbsp;/api/Files/1.0/presigned/{presignedUrl}/content&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Auth:&amp;nbsp;none&amp;nbsp;(the&amp;nbsp;token&amp;nbsp;authorises)&lt;br&gt;&amp;nbsp;&amp;nbsp;path&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;presignedUrl&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;required&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;The&amp;nbsp;pre-signed&amp;nbsp;token&amp;nbsp;to&amp;nbsp;redeem&lt;br&gt;&amp;nbsp;&amp;nbsp;header&amp;nbsp;&amp;nbsp;&amp;nbsp;ThruApplication&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;optional&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Calling&amp;nbsp;application&amp;nbsp;name,&amp;nbsp;for&amp;nbsp;tracing&lt;br&gt;&amp;nbsp;&amp;nbsp;header&amp;nbsp;&amp;nbsp;&amp;nbsp;X-Thru-Tracking-ThruNodeId&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;optional&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Originating&amp;nbsp;MFT&amp;nbsp;node,&amp;nbsp;for&amp;nbsp;tracing&lt;br&gt;&amp;nbsp;&amp;nbsp;header&amp;nbsp;&amp;nbsp;&amp;nbsp;Range&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;string,&amp;nbsp;optional&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;e.g.&amp;nbsp;bytes=1073741824-&amp;nbsp;to&amp;nbsp;resume&amp;nbsp;(returns&amp;nbsp;206)&lt;br&gt;&amp;nbsp;&amp;nbsp;returns&amp;nbsp;&amp;nbsp;200&amp;nbsp;full&amp;nbsp;stream&amp;nbsp;|&amp;nbsp;206&amp;nbsp;byte&amp;nbsp;range&amp;nbsp;|&amp;nbsp;400&amp;nbsp;malformed&amp;nbsp;|&amp;nbsp;404&amp;nbsp;unknown/expired/not&amp;nbsp;found&amp;nbsp;|&amp;nbsp;409&amp;nbsp;disabled&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Response&amp;nbsp;header&amp;nbsp;X-Thru-Path:&amp;nbsp;stored&amp;nbsp;file&amp;nbsp;path&amp;nbsp;relative&amp;nbsp;to&amp;nbsp;the&amp;nbsp;endpoint&amp;nbsp;root&lt;/font&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#F7F9FB;strokeColor=#9AA5B1;strokeWidth=0.83;fontColor=#1F2933;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="1677.0" width="848.0" height="213.4" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Points to confirm with Boomi / NRS&lt;/b&gt;&lt;br&gt;1.  Does each Range request count against maxDownloads (1 to 10)?&lt;br&gt;     If not, parallel ranged GETs become an option for large files.&lt;br&gt;2.  Does an in-flight stream survive the token reaching activeDuration?&lt;br&gt;     Size it to the largest file: 20 GB at 100 Mbit/s is about 27 minutes.&lt;br&gt;3.  How NRS learns the fileReferenceId (step 2): event, SDEC message or FileList.&lt;br&gt;4.  NRS is itself an authenticated caller, so the authenticated&lt;br&gt;     &amp;#x27;Download a file&amp;#x27;s content by file reference&amp;#x27; GET (also Range-capable)&lt;br&gt;     skips the token step. The pre-signed route fits when the download&lt;br&gt;     runs in a separate worker that should not hold MFT credentials.&lt;br&gt;5.  Retention / deletion of the file in MFT once NRS confirms receipt.&lt;br&gt;6.  Network path NRS to MFT (DMZ / corporate VPC, public FQDN DNS)." style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FFF8DB;strokeColor=#C9A227;strokeWidth=0.83;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="896.0" y="1677.0" width="628.0" height="213.4" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot;&gt;SDEC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Sender (HMRC)" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#E8F0FA;strokeColor=#1D4E89;strokeWidth=1.67;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="38.0" y="94.4" width="196.0" height="57.6" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;SDEC&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#E8F0FA;strokeColor=#1D4E89;strokeWidth=1.11;fontColor=#1F2933;fontSize=10.0;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="38.0" y="1629.0" width="196.0" height="24.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot;&gt;Boomi MFT (Thru)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Files API /api/Files/1.0 + flow storage" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FBEBDC;strokeColor=#B3591A;strokeWidth=1.67;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="382.0" y="94.4" width="196.0" height="57.6" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Boomi MFT (Thru)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FBEBDC;strokeColor=#B3591A;strokeWidth=1.11;fontColor=#1F2933;fontSize=10.0;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="382.0" y="1629.0" width="196.0" height="24.0" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot;&gt;NRS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Downloader service" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#E4F3E9;strokeColor=#1E6B3A;strokeWidth=1.67;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="814.0" y="94.4" width="196.0" height="57.6" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;NRS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#E4F3E9;strokeColor=#1E6B3A;strokeWidth=1.11;fontColor=#1F2933;fontSize=10.0;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="814.0" y="1629.0" width="196.0" height="24.0" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot;&gt;NRS S3 bucket&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Target object storage" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FCEBE5;strokeColor=#B3401A;strokeWidth=1.67;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1102.0" y="94.4" width="196.0" height="57.6" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;NRS S3 bucket&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#FCEBE5;strokeColor=#B3401A;strokeWidth=1.11;fontColor=#1F2933;fontSize=10.0;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1102.0" y="1629.0" width="196.0" height="24.0" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;&lt;font style=&quot;font-size:13.3px&quot;&gt;Token issuer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;OAuth2 (or ApiKey)" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEE8F6;strokeColor=#5B3F8C;strokeWidth=1.67;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1322.0" y="94.4" width="196.0" height="57.6" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Token issuer&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#EEE8F6;strokeColor=#5B3F8C;strokeWidth=1.11;fontColor=#1F2933;fontSize=10.0;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1322.0" y="1629.0" width="196.0" height="24.0" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;NRS pull of SDEC attachments via Boomi MFT pre-signed download URL&lt;/b&gt;" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#1F2933;fontSize=18.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="28.0" width="1496.0" height="28.8" as="geometry"/></mxCell><mxCell id="c41" value="API interaction sequence  |  Draft v0.1, 13 Nov 2026  |  Alternative to the S3 pre-signed PUT URL (5 GB single-PUT limit)" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=11.1;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="58.4" width="1496.0" height="19.2" as="geometry"/></mxCell><mxCell id="c42" value="1.  Deliver attachment to the MFT flow endpoint&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;/{customerCode}/{flow}/{flowEndpoint}" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="136.0" y="245.8" as="sourcePoint"/><mxPoint x="480.0" y="245.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="2.  File-available signal carrying fileReferenceId&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(mechanism&amp;nbsp;TBC:&amp;nbsp;MFT&amp;nbsp;event,&amp;nbsp;SDEC&amp;nbsp;message&amp;nbsp;or&amp;nbsp;FileList&amp;nbsp;API)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#C26A00;strokeWidth=1.4;fontColor=#C26A00;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="343.9" as="sourcePoint"/><mxPoint x="912.0" y="343.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="3.  POST token request&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;grant_type=client_credentials" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="436.9" as="sourcePoint"/><mxPoint x="1420.0" y="436.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="4.  200 OK  access_token (Bearer)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420.0" y="473.0" as="sourcePoint"/><mxPoint x="912.0" y="473.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="5.  POST /api/Files/1.0/{fileReferenceId}/presigned&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Authorization:&amp;nbsp;Bearer&amp;nbsp;&amp;lt;access_token&amp;gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;ThruApplication:&amp;nbsp;NRS&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;X-Thru-Tracking-ThruNodeId:&amp;nbsp;&amp;lt;optional&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Body:&amp;nbsp;{&amp;nbsp;&amp;quot;endpointPath&amp;quot;:&amp;nbsp;&amp;quot;/{customerCode}/{flow}/{flowEndpoint}&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;quot;maxDownloads&amp;quot;:&amp;nbsp;3,&amp;nbsp;&amp;nbsp;&amp;quot;activeDuration&amp;quot;:&amp;nbsp;3600&amp;nbsp;}" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="602.2" as="sourcePoint"/><mxPoint x="480.0" y="602.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="6.  200 OK   { &amp;quot;presignedUrl&amp;quot;: &amp;quot;&amp;lt;token&amp;gt;&amp;quot; }" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="699.6" as="sourcePoint"/><mxPoint x="912.0" y="699.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="7.  CreateMultipartUpload (AWS SDK, IAM role)" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="780.5" as="sourcePoint"/><mxPoint x="1200.0" y="780.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="8.  UploadId" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="816.6" as="sourcePoint"/><mxPoint x="912.0" y="816.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="9.  GET /api/Files/1.0/presigned/{presignedUrl}/content&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;No&amp;nbsp;Authorization&amp;nbsp;header:&amp;nbsp;the&amp;nbsp;token&amp;nbsp;authorises&amp;nbsp;the&amp;nbsp;call&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ThruApplication:&amp;nbsp;NRS&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;Range:&amp;nbsp;bytes=0-&amp;nbsp;&amp;nbsp;(optional)" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="876.9" as="sourcePoint"/><mxPoint x="480.0" y="876.9" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="10.  200 OK   application/octet-stream (raw byte stream)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;X-Thru-Path:&amp;nbsp;&amp;lt;stored&amp;nbsp;path&amp;nbsp;relative&amp;nbsp;to&amp;nbsp;endpoint&amp;nbsp;root&amp;gt;" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="925.1" as="sourcePoint"/><mxPoint x="912.0" y="925.1" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="11.  UploadPart (partNumber n, UploadId)" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="991.6" as="sourcePoint"/><mxPoint x="1200.0" y="991.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="12.  ETag for part n" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="1027.6" as="sourcePoint"/><mxPoint x="912.0" y="1027.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="13.  GET /api/Files/1.0/presigned/{presignedUrl}/content&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Range:&amp;nbsp;bytes=&amp;lt;last&amp;nbsp;byte&amp;nbsp;received&amp;nbsp;+&amp;nbsp;1&amp;gt;-" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="1126.2" as="sourcePoint"/><mxPoint x="480.0" y="1126.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="14.  206 Partial Content (remaining bytes)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="1162.3" as="sourcePoint"/><mxPoint x="912.0" y="1162.3" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="15.  CompleteMultipartUpload (part numbers + ETags)" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=0;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="912.0" y="1218.4" as="sourcePoint"/><mxPoint x="1200.0" y="1218.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="16.  200 OK  object stored (multipart: up to 10,000 parts, no 5 GB cap)" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#1F2933;strokeWidth=1.4;fontColor=#1F2933;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="1254.5" as="sourcePoint"/><mxPoint x="912.0" y="1254.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="17.  400  Presigned URL missing or malformed&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Fix&amp;nbsp;the&amp;nbsp;request;&amp;nbsp;do&amp;nbsp;not&amp;nbsp;retry&amp;nbsp;as-is" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#B3261E;strokeWidth=1.4;fontColor=#B3261E;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="1427.8" as="sourcePoint"/><mxPoint x="912.0" y="1427.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="18.  404  Token unknown, expired or exhausted, or file not found&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Request&amp;nbsp;a&amp;nbsp;fresh&amp;nbsp;token&amp;nbsp;(repeat&amp;nbsp;step&amp;nbsp;5),&amp;nbsp;then&amp;nbsp;resume&amp;nbsp;with&amp;nbsp;Range" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#B3261E;strokeWidth=1.4;fontColor=#B3261E;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="1504.8" as="sourcePoint"/><mxPoint x="912.0" y="1504.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="19.  409  Target resource is disabled&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Raise&amp;nbsp;with&amp;nbsp;the&amp;nbsp;MFT&amp;nbsp;platform&amp;nbsp;team" style="endArrow=open;endFill=0;html=1;rounded=0;dashed=1;strokeColor=#B3261E;strokeWidth=1.4;fontColor=#B3261E;fontSize=9.4;fontFamily=Segoe UI;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;align=center;spacingBottom=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="1581.8" as="sourcePoint"/><mxPoint x="912.0" y="1581.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value="Legend:  solid arrow = request   |   dashed arrow = response   |   orange dashed = to be confirmed   |   red dashed = error response" style="rounded=0;arcSize=8;whiteSpace=nowrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.11;fontColor=#52606D;fontSize=8.9;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="28.0" y="1910.4" width="1496.0" height="16.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>