<mxfile host="app.diagrams.net"><diagram id="boomi-mft-roles-permissions" name="Boomi MFT role permissions, Approach B"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ipaas" value="&lt;b&gt;iPaaS platform team&lt;/b&gt;&lt;br&gt;&lt;i&gt;Platform administrators&lt;/i&gt;&lt;br&gt;&lt;i&gt;Only role that creates organizations&lt;/i&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdf6e3;strokeColor=#7a5a00;strokeWidth=1.6;dashed=0;verticalAlign=middle;align=left;spacingLeft=16;spacingTop=4;fontSize=15;fontColor=#7a5a00;spacingRight=1240;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1520" height="120" as="geometry"/></mxCell><mxCell id="ip0" value="Create organization" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;strokeWidth=1.6;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="260" height="60" as="geometry"/></mxCell><mxCell id="ip1" value="Assign Standard_Admin&lt;br&gt;and Standard_User" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;strokeWidth=1.6;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="260" height="60" as="geometry"/></mxCell><mxCell id="ip2" value="Grant access to other&lt;br&gt;organizations on request" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;strokeWidth=1.6;dashed=0;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="260" height="60" as="geometry"/></mxCell><mxCell id="ip3" value="Set up sites, instances&lt;br&gt;and 