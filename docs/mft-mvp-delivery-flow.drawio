<mxfile host="app.diagrams.net"><diagram name="MVP Delivery Flow" id="mvp"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Boomi MFT MVP: high-level delivery flow (no dates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D2B3A;strokeColor=#1D2B3A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1080" height="36" as="geometry"/></mxCell><mxCell id="n3" value="Leg A: NPS to ADR landing  |  Leg B: ADR output to ONS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1080" height="28" as="geometry"/></mxCell><mxCell id="n4" value="P0 Mobilise and confirm&lt;br&gt;Governance&lt;br&gt;Exit: Decision log signed off; owners named; file profile confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="100" as="geometry"/></mxCell><mxCell id="n5" value="P1 Environments and connectivity&lt;br&gt;Platform (critical path)&lt;br&gt;Exit: All endpoints reachable from runtime in lower environments with evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6D7C9;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="150" height="100" as="geometry"/></mxCell><mxCell id="n6" value="P2 Security and credentials&lt;br&gt;Security&lt;br&gt;Exit: Security design approved; credentials and keys in place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE3F2;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="216" y="110" width="150" height="100" as="geometry"/></mxCell><mxCell id="n7" value="P3 Configure Leg A (NPS to ADR)&lt;br&gt;Build&lt;br&gt;Exit: Leg A runs in Dev with a synthetic file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E6D2;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="216" y="230" width="150" height="100" as="geometry"/></mxCell><mxCell id="n8" value="P4 Configure Leg B (ADR to ONS)&lt;br&gt;Build&lt;br&gt;Exit: Leg B delivers to ONS lower environment with acknowledgement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E6D2;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="216" y="350" width="150" height="100" as="geometry"/></mxCell><mxCell id="n9" value="P5 CI/CD promotion&lt;br&gt;Build&lt;br&gt;Exit: Both legs promoted to Pre-prod via approved pipeline with audit trail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E6D2;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="392" y="110" width="150" height="100" as="geometry"/></mxCell><mxCell id="n10" value="P6 Observability and audit&lt;br&gt;Operate&lt;br&gt;Exit: Dashboards and alerts demonstrated to operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8EA;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="392" y="230" width="150" height="100" as="geometry"/></mxCell><mxCell id="n11" value="P7 Test&lt;br&gt;Assure&lt;br&gt;Exit: Evidence pack reviewed; defects closed or accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EBC9;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="568" y="110" width="150" height="100" as="geometry"/></mxCell><mxCell id="n12" value="P8 Prove in production and hand over&lt;br&gt;Operate&lt;br&gt;Exit: Live feed delivered; service accepted by operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8EA;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="744" y="110" width="150" height="100" as="geometry"/></mxCell><mxCell id="n13" value="P9 Go/no-go and scale recommendation&lt;br&gt;Governance&lt;br&gt;Exit: Recommendation issued; definition of done met" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="150" height="100" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#1D2B3A;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="Key recommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D2B3A;strokeColor=#1D2B3A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1080" height="28" as="geometry"/></mxCell><mxCell id="n24" value="R1 Treat connectivity as the critical path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="262" height="52" as="geometry"/></mxCell><mxCell id="n25" value="R2 Test file size against the AV scan ceiling early" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="312" y="540" width="262" height="52" as="geometry"/></mxCell><mxCell id="n26" value="R3 Decide credential storage explicitly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="584" y="540" width="262" height="52" as="geometry"/></mxCell><mxCell id="n27" value="R4 Document rollback for config promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="856" y="540" width="262" height="52" as="geometry"/></mxCell><mxCell id="n28" value="R5 Build against current ADR, re-point later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="602" width="262" height="52" as="geometry"/></mxCell><mxCell id="n29" value="R6 Prove SFTP through any load balancer early" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="312" y="602" width="262" height="52" as="geometry"/></mxCell><mxCell id="n30" value="R7 Keep the legacy route warm until live proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="584" y="602" width="262" height="52" as="geometry"/></mxCell><mxCell id="n31" value="R8 Agree the ONS acknowledgement mechanism" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6CC;strokeColor=#1D2B3A;fontColor=#1D2B3A;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="856" y="602" width="262" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>