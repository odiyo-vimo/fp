<mxfile host="app.diagrams.net" type="device"><diagram name="MFT-clustered-deployment-v1.0"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="Boomi MFT clustered deployment with load balancer" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#12123A;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="24" width="1200" height="30" as="geometry"/></mxCell><mxCell id="sub" value="The MFT runtime on Boomi MCS calls a load balancer, which distributes across clustered nodes on cloud compute instances, which then connect to the respective HOD endpoint." style="text;html=1;fontSize=12;fontColor=#5b6b7d;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="60" width="1420" height="40" as="geometry"/></mxCell><mxCell id="z1" value="&lt;b&gt;Boomi Managed Cloud Services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;MCS, vendor operated SaaS runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontColor=#12123A;fillColor=#eef4fb;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="24" y="116" width="280" height="420" as="geometry"/></mxCell><mxCell id="z2" value="&lt;b&gt;Network edge, trust boundary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Egress control, DNS, load balancing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontColor=#12123A;fillColor=#f4f7fb;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="326" y="116" width="232" height="420" as="geometry"/></mxCell><mxCell id="z3" value="&lt;b&gt;Cloud IaaS, clustered runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Compute instances hosting the nodes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontColor=#12123A;fillColor=#eef7f1;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="580" y="116" width="380" height="420" as="geometry"/></mxCell><mxCell id="z4" value="&lt;b&gt;Host systems and incumbent estate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Destination endpoints reached by the nodes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontColor=#12123A;fillColor=#fbf5e8;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="982" y="116" width="494" height="420" as="geometry"/></mxCell><mxCell id="z5" value="&lt;b&gt;Shared platform services and cluster dependencies&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Used by every node in the cluster, not held on any single node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontColor=#12123A;fillColor=#f4f7fb;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="24" y="556" width="1452" height="192" as="geometry"/></mxCell><mxCell id="mft" value="&lt;b&gt;MFT runtime (AFT engine)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Transfer orchestration, protocol&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;handling, retry and resume&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#dbe8f7;strokeColor=#2e6ca4;" vertex="1" parent="1"><mxGeometry x="42" y="168" width="244" height="76" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;Config catalogue and console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;One config row per interface&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="42" y="254" width="244" height="58" as="geometry"/></mxCell><mxCell id="sch" value="&lt;b&gt;Scheduler and event triggers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Time, arrival and API initiated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="42" y="322" width="244" height="52" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b&gt;File Sharing (FS) module&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Ad hoc citizen upload and download&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="42" y="384" width="244" height="52" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Audit, logging and alerting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;One record per transfer, retained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="42" y="446" width="244" height="58" as="geometry"/></mxCell><mxCell id="egr" value="&lt;b&gt;Egress control and TLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;TLS 1.2+ outbound&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Source ranges allow listed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="344" y="168" width="196" height="64" as="geometry"/></mxCell><mxCell id="dns" value="&lt;b&gt;DNS, one virtual hostname&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;One name for the whole cluster&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="344" y="242" width="196" height="50" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;Load balancer (VIP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Distributes across live nodes&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;L4 for SFTP and FTPS,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;L7 for HTTPS and AS2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#dbe8f7;strokeColor=#2e6ca4;" vertex="1" parent="1"><mxGeometry x="344" y="302" width="196" height="88" as="geometry"/></mxCell><mxCell id="ses" value="&lt;b&gt;Session and port handling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Persistence, FTPS passive&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;range, client IP preservation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#fbf1ee;strokeColor=#E24A2E;" vertex="1" parent="1"><mxGeometry x="344" y="400" width="196" height="70" as="geometry"/></mxCell><mxCell id="hp" value="&lt;b&gt;Health probes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Controls node rotation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="344" y="480" width="196" height="52" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Instance 1, Node 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Cluster member, in rotation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Runs the generic MFT engine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Availability zone A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#e3f1e9;strokeColor=#1d7a4d;" vertex="1" parent="1"><mxGeometry x="598" y="168" width="344" height="94" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Instance 2, Node 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Cluster member, in rotation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Runs the generic MFT engine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Availability zone B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#e3f1e9;strokeColor=#1d7a4d;" vertex="1" parent="1"><mxGeometry x="598" y="274" width="344" height="94" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Instance 3, Node N&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Horizontal scale unit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Added without new Boomi components&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Availability zone C&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#e3f1e9;strokeColor=#1d7a4d;" vertex="1" parent="1"><mxGeometry x="598" y="380" width="344" height="94" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;HOD endpoint A, SFTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Managed key based authentication&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="1000" y="168" width="458" height="68" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;HOD endpoint B, network file share&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Reached inside the LAN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="1000" y="246" width="458" height="68" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;HOD endpoint C, application drop zone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Directory watched by the host application&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="1000" y="324" width="458" height="68" as="geometry"/></mxCell><mxCell id="inc" value="&lt;b&gt;Incumbent estate, ESDES and SDS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Complemented, not replaced.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Boomi MFT sits alongside&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#f6ece0;strokeColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="1000" y="400" width="458" height="66" as="geometry"/></mxCell><mxCell id="sie" value="&lt;b&gt;Monitoring and SIEM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Cluster and transfer events,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;correlated with platform audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="1000" y="474" width="458" height="60" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b&gt;Shared by every node in the cluster&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="520" y="558" width="460" height="32" as="geometry"/></mxCell><mxCell id="shr" value="&lt;b&gt;Shared cluster file system&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Common working and staging&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;directory visible to all nodes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="42" y="622" width="222" height="98" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Cluster database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Shared state and cache table&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;with TTL, not node local&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="281" y="622" width="222" height="98" as="geometry"/></mxCell><mxCell id="pam" value="&lt;b&gt;Credential source&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;CyberArk PAM, gap G-14,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;no documented native path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#fbf5e8;strokeColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="520" y="622" width="222" height="98" as="geometry"/></mxCell><mxCell id="av" value="&lt;b&gt;AV scan hook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Approx 250 MB ceiling,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;gap G-15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#fbf5e8;strokeColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="759" y="622" width="222" height="98" as="geometry"/></mxCell><mxCell id="prm" value="&lt;b&gt;Config promotion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;No native CI/CD for MFT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;config, gap G-13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#fbf5e8;strokeColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="998" y="622" width="222" height="98" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Node telemetry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;Per node health and&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6b7d&quot;&gt;throughput metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;spacingLeft=8;fontSize=11;fontColor=#12123A;fillColor=#ffffff;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="1237" y="622" width="222" height="98" as="geometry"/></mxCell><mxCell id="e0" value="1  transfer request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mft" target="egr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="2  resolve hostname" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="egr" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="3  reach the VIP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dns" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="4  select a node" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lb" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lb" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lb" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="5  probe result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hp" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="constrains" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ses" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="6  shared dependencies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus" target="shr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus" target="pam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus" target="av"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus" target="prm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bus" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="7  connect to the HOD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=0;strokeColor=#2e6ca4;strokeWidth=2;fontSize=10;fontColor=#12123A;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="telemetry feed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#5b6b7d;strokeWidth=1.4;fontSize=10;fontColor=#5b6b7d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="obs" target="sie"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Request sequence&lt;/b&gt;&lt;br&gt;1  The MFT runtime on Boomi MCS raises the outbound transfer request over TLS.&lt;br&gt;2  The virtual hostname for the cluster is resolved, so no node address is ever published.&lt;br&gt;3  The request lands on the load balancer VIP inside the target cloud network.&lt;br&gt;4  The load balancer selects a node that is currently in rotation and passes the session to it.&lt;br&gt;5  Health probes continuously decide which nodes stay in rotation and which are drained.&lt;br&gt;6  The node works against the shared file system, cluster database and credential source.&lt;br&gt;7  The node opens the connection to the respective HOD endpoint and moves the file." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#12123A;fillColor=#f6f8fb;strokeColor=#cdd8e8;" vertex="1" parent="1"><mxGeometry x="24" y="772" width="1452" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>