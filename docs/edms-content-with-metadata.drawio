<mxfile host="app.diagrams.net"><diagram id="edms-cwm" name="Get content with metadata"><mxGraphModel dx="1840" dy="1962" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1962" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;EDMS: Get content stream with metadata&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="900" height="26" as="geometry"/></mxCell><mxCell id="c4" value="GET /edms/v1/documents/{documentId}/content-with-metadata  |  Consumer &amp;gt; Boomi CAM &amp;gt; Boomi iPaaS &amp;gt; Doxis, with Entra ID token validation and SCR Broker check" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=left;fontSize=12;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c5" value="break" style="shape=umlFrame;whiteSpace=wrap;html=1;width=52;height=22;boundedLbl=1;verticalAlign=top;align=center;fontStyle=1;fontFamily=Segoe UI;fontSize=12;strokeColor=#7B8794;fillColor=#E4E7EB;swimlaneFillColor=none;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="1200" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;[token invalid, expired, wrong issuer or audience, or scope missing]&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=left;fontSize=12;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="80" y="592" width="1130" height="20" as="geometry"/></mxCell><mxCell id="c7" value="break" style="shape=umlFrame;whiteSpace=wrap;html=1;width=52;height=22;boundedLbl=1;verticalAlign=top;align=center;fontStyle=1;fontFamily=Segoe UI;fontSize=12;strokeColor=#7B8794;fillColor=#E4E7EB;swimlaneFillColo