" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;[authorised]&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=left;fontSize=12;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="80" y="1530" width="1710" height="20" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#7B8794;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="1704" as="sourcePoint"/><mxPoint x="1800" y="1704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;[not SCR certified, not entitled, or SCR Broker unavailable (fail closed)]&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=left;fontSize=12;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="28" y="1707" width="1760" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9AA5B1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="128" as="sourcePoint"/><mxPoint x="130" y="1874" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;API Consumer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;Generic consumer&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#52606D;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20.0" y="70" width="220" height="58" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;API Consumer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;Generic consumer&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#52606D;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20.0" y="1874" width="220" height="58" as="geometry"/></mxCell><mxCell id="c20" value=