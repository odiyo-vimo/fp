ly=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630.0" y="1874" width="220" height="58" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9AA5B1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="128" as="sourcePoint"/><mxPoint x="1060" y="1874" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;Identity provider&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EFE2;strokeColor=#7A5A00;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="950.0" y="70" width="220" height="58" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;Identity provider&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EFE2;strokeColor=#7A5A00;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="950.0" y="1874" width="220" height="58" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9AA5B1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="128" as="sourcePoint"/><mxPoint x="1360" y="1874" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Doxis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;EDMS backend&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3E9;strokeColor=#1E6B3A;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1250.0" y="70" width="220" height="58" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Doxis&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;EDMS backend&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E4F3E9;strokeColor=#1E6B3A;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1250.0" y="1874" width="220" height="58" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#9AA5B1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="128" as="sourcePoint"/><mxPoint x="1640" y="1874" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;SCR Broker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;SCR backend&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCEBE5;strokeColor=#B3401A;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1530.0" y="70" width="220" height="58" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;SCR Broker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52606D&quot; style=&quot;font-size:12px&quot;&gt;SCR backend&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCEBE5;strokeColor=#B3401A;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1530.0" y="1874" width="220" height="58" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F2933;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="248" as="sourcePoint"/><mxPoint x="420" y="248" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="1. GET content-with-metadata for&lt;br&gt;{documentId} (optional version,&lt;br&gt;representationId, contentObjectId).&lt;br&gt;Bearer Entra ID token, Accept:&lt;br&gt;multipart/mixed" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="140" y="160" width="270" height="84" as="geometry"/></mxCell><mxCell id="c37" value="2. Apply gateway policies: TLS,&lt;br&gt;throttling and quota, assign&lt;br&gt;X-Correlation-ID" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="285.0" y="266" width="270" height="62" as="geometry"/></mxCell><mxCell id="c38" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F2933;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="398" as="sourcePoint"/><mxPoint x="740" y="398" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="3. Route request to EDMS integration&lt;br&gt;process (Authorization header passed&lt;br&gt;through unchanged, X-Correlation-ID)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="430" y="342" width="300" height="52" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F2933;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="454" as="sourcePoint"/><mxPoint x="1060" y="454" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="4. Get token signing keys (JWKS, cached by&lt;br&gt;key id)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="414" width="300" height="36" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#1F2933;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="494" as="sourcePoint"/><mxPoint x="740" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="5. JWKS signing keys" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="470" width="300" height="20" as="geometry"/></mxCell><mxCell id="c44" value="6. Validate Entra ID access token:&lt;br&gt;signature, expiry, issuer, API audience&lt;br&gt;and documents.content.read scope" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="595.0" y="512" width="290" height="62" as="geometry"/></mxCell><mxCell id="c45" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#B3401A;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="658" as="sourcePoint"/><mxPoint x="130" y="658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="6a. 401 Unauthorized (WWW-Authenticate) or 403 Forbidden (scope missing), returned via&lt;br&gt;CAM" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#B3401A;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="140" y="618" width="590" height="36" as="geometry"/></mxCell><mxCell id="c47" value="7. Validate documentId: two UUIDs&lt;br&gt;separated by one underscore" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="595.0" y="696" width="290" height="46" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#B3401A;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="810" as="sourcePoint"/><mxPoint x="130" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="7a. 400 Bad Request (invalid documentId), returned via CAM" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#B3401A;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="140" y="786" width="590" height="20" as="geometry"/></mxCell><mxCell id="c50" value="8. Split documentId into repositoryUUID&lt;br&gt;and documentUUID. Repository is not&lt;br&gt;exposed as a consumer parameter" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="595.0" y="848" width="290" height="62" as="geometry"/></mxCell><mxCell id="c51" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F2933;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="964" as="sourcePoint"/><mxPoint x="1360" y="964" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="9. GetContentObjectStreamWithMetadata (Doxis adapter): repositoryUUID, documentUUID,&lt;br&gt;version?, representationId?, contentObjectId?" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="924" width="600" height="36" as="geometry"/></mxCell><mxCell id="c53" value="10. Resolve version (latest if&lt;br&gt;omitted), representation (primary if&lt;br&gt;omitted) and content object (primary&lt;br&gt;if omitted)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1230.0" y="982" width="260" height="78" as="geometry"/></mxCell><mxCell id="c54" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#1F2933;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="1098" as="sourcePoint"/><mxPoint x="740" y="1098" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="11. Document metadata and content stream (stream opened, not yet consumed)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="1074" width="600" height="20" as="geometry"/></mxCell><mxCell id="c56" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#B3401A;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1168" as="sourcePoint"/><mxPoint x="130" y="1168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="11a. 404 Not Found, returned via CAM" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#B3401A;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="140" y="1144" width="590" height="20" as="geometry"/></mxCell><mxCell id="c58" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#B3401A;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1238" as="sourcePoint"/><mxPoint x="130" y="1238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="11b. 502 Bad Gateway or 504 Gateway Timeout, returned via CAM" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#B3401A;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="140" y="1214" width="590" height="20" as="geometry"/></mxCell><mxCell id="c60" value="12. Normalise metadata to&lt;br&gt;EdmsMetaDataResponse. Hold the content&lt;br&gt;stream open: no Base64, no full-file&lt;br&gt;buffering" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="595.0" y="1276" width="290" height="78" as="geometry"/></mxCell><mxCell id="c61" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1F2933;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="1392" as="sourcePoint"/><mxPoint x="1640" y="1392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="13. Check SCR certification for the caller (identity from validated token claims)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="1368" width="880" height="20" as="geometry"/></mxCell><mxCell id="c63" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#1F2933;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="1432" as="sourcePoint"/><mxPoint x="740" y="1432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="14. SCR status: certified or not certified" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Segoe UI;align=center;verticalAlign=bottom;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="1408" width="880" height="20" as="geometry"/></mxCell><mxCell id="c65" value="15. Authorisation decision: caller SCR&lt;br&gt;certified and entitled to this document&lt;br&gt;(document security metadata)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontFamily=Segoe UI;