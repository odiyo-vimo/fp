<mxfile host="app.diagrams.net"><diagram id="boomi-mft-platform" name="Boomi MFT platform"><mxGraphModel dx="1600" dy="1040" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_ext" value="External parties" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#f4eef8;strokeColor=#7b3fa0;verticalAlign=top;align=left;spacingLeft=620;spacingTop=6;fontStyle=1;fontSize=16;fontColor=#7b3fa0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1520" height="190" as="geometry"/></mxCell><mxCell id="z_cloud" value="Boomi MFT Cloud: Boomi-hosted, one tenant" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#eef3f8;strokeColor=#1d4e89;verticalAlign=top;align=left;spacingLeft=620;spacingTop=6;fontStyle=1;fontSize=16;fontColor=#1d4e89;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1520" height="240" as="geometry"/></mxCell><mxCell id="z_int" value="Internal network: AWS now, Azure in design" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#edf6ef;strokeColor=#1e6b3a;verticalAlign=top;align=left;spacingLeft=620;spacingTop=6;fontStyle=1;fontSize=16;fontColor=#1e6b3a;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1520" height="240" as="geometry"/></mxCell><mxCell id="admins" value="&lt;b style=&quot;font-size:17px&quot;&gt;Platform admins&lt;/b&gt;&lt;br&gt;Flow Studio, admin portal&lt;br&gt;Intelligrator self-service" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="partners" value="&lt;b style=&quot;font-size:17px&quot;&gt;Partners and SaaS&lt;/b&gt;&lt;br&gt;SFTP, FTPS, HTTPS, cloud storage&lt;br&gt;e.g. Pega landing zones" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="extusers" value="&lt;b style=&quot;font-size:17px&quot;&gt;External users&lt;/b&gt;&lt;br&gt;Citizens and stakeholders&lt;br&gt;No MFT account needed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3f3f1;strokeColor=#0f6e66;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1220" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="apis" value="&lt;b style=&quot;font-size:17px&quot;&gt;MFT APIs and Connector&lt;/b&gt;&lt;br&gt;Management, Activity, FS APIs&lt;br&gt;Boomi Integration processes&lt;br&gt;API Management" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="80" y="345" width="300" height="140" as="geometry"/></mxCell><mxCell id="aft" value="&lt;b style=&quot;font-size:17px&quot;&gt;Automated File Transfer&lt;/b&gt;&lt;br&gt;Organizations, Endpoints, Flows&lt;br&gt;Schedules, run-now, retries&lt;br&gt;MFT SFTP, FTPS, HTTPS servers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="460" y="345" width="300" height="140" as="geometry"/></mxCell><mxCell id="store" value="&lt;b style=&quot;font-size:17px&quot;&gt;Persistent storage&lt;/b&gt;&lt;br&gt;Files held until delivered&lt;br&gt;Activity, alerts, audit&lt;br&gt;Encrypted at rest" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="840" y="345" width="300" height="140" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b style=&quot;font-size:17px&quot;&gt;File Sharing (FS)&lt;/b&gt;&lt;br&gt;Web app, Dropbox, secure links&lt;br&gt;Outlook, Office 365, Salesforce&lt;br&gt;Login, expiry, permissions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3f3f1;strokeColor=#0f6e66;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1220" y="345" width="300" height="140" as="geometry"/></mxCell><mxCell id="av" value="&lt;b style=&quot;font-size:17px&quot;&gt;AV scan (MDE)&lt;/b&gt;&lt;br&gt;Fail closed&lt;br&gt;Limit about 250 MB (G-15)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3e4c59;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="300" height="140" as="geometry"/></mxCell><mxCell id="node" value="&lt;b style=&quot;font-size:17px&quot;&gt;MFT Node (Local Node)&lt;/b&gt;&lt;br&gt;Windows or Linux on EC2&lt;br&gt;Outbound HTTPS only&lt;br&gt;Serves internal endpoints" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="460" y="640" width="300" height="140" as="geometry"/></mxCell><mxCell id="stores" value="&lt;b style=&quot;font-size:17px&quot;&gt;Internal endpoints&lt;/b&gt;&lt;br&gt;S3, Azure Blob, Azure Files&lt;br&gt;File Share (LAN) endpoints&lt;br&gt;IAM and KMS controlled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f0fa;strokeColor=#1d4e89;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="840" y="640" width="300" height="140" as="geometry"/></mxCell><mxCell id="staff" value="&lt;b style=&quot;font-size:17px&quot;&gt;Staff and agents&lt;/b&gt;&lt;br&gt;Browser, Outlook add-in&lt;br&gt;SMIC dynamic links" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e3f3f1;strokeColor=#0f6e66;strokeWidth=1.8;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1220" y="640" width="300" height="140" as="geometry"/></mxCell><mxCell id="e1" value="Configure" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="admins" target="apis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Push or pull" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="partners" target="aft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Upload, download" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="extusers" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="apis" target="aft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="aft" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="store" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Node connects out (HTTPS)" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="node" target="aft"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.000;exitY=0.500;entryX=1.000;entryY=0.500;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="node" target="av"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="node" target="stores"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Share, send" style="edgeStyle=none;html=1;rounded=0;strokeColor=#3e4c59;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.500;exitY=0.000;entryX=0.500;entryY=1.000;labelBackgroundColor=#ffffff;fontSize=13;labelBorderColor=#9aa5b1;spacing=4;" edge="1" parent="1" source="staff" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Legend: blue = Automated File Transfer (system to system); teal = File Sharing (person to person); white = shared platform service or external party. The MFT Node opens every connection to the Cloud, so no inbound port is opened to the internal network." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#c5ccd3;align=left;spacingLeft=14;fontSize=13;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="1520" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>