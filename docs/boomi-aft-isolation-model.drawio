"/></mxCell><mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;br&gt;Human&lt;br&gt;accounts,&lt;br&gt;role-based&lt;br&gt;access" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#6B2C91;strokeWidth=1.4;fontColor=#6B2C91;fontSize=13;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="388" y="352" width="118" height="180" as="geometry"/></mxCell><mxCell id="musers" value="&lt;b&gt;Machine users&lt;/b&gt;&lt;br&gt;&lt;br&gt;Service / API&lt;br&gt;accounts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#6B2C91;strokeWidth=1.4;fontColor=#6B2C91;fontSize=13;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="518" y="352" width="124" height="180" as="geometry"/></mxCell><mxCell id="org_foot" value="All scoped to exactly one organization" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#6B2C91;" vertex="1" parent="1"><mxGeometry x="250" y="556" width="410" height="20" as="geometry"/></mxCell><mxCell id="srctgt" value="source →&lt;br&gt;target" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#55607A;" vertex="1" parent="1"><mxGeometry x="150" y="300" width="80" height="40" as="geometry"/></mxCell><mxCell id="instB" value="&lt;b&gt;Instance B&lt;/b&gt;&lt;br&gt;(isolated, collapsed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F4F5F7;strokeColor=#8A94A6;strokeWidth=1.4;fontColor=#4a5361;fontSize=14;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="858" y="205" width="282" height="200" as="geometry"/></mxCell><mxCell id="instC" value="&lt;b&gt;Instance C&lt;/b&gt;&lt;br&gt;(isolated, collapsed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F4F5F7;strokeColor=#8A94A6;strokeWidth=1.4;fontColor=#4a5361;fontSize=14;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="858" y="430" width="282" height="215" as="geometry"/></mxCell><mxCell id="cap" value="A single site can host one or many logically isolated instances, each fully walled off from the others.&lt;br&gt;Within an instance, organizations represent the businesses or partners exchanging files, and every&lt;br&gt;endpoint, user, and machine user is scoped to its own organization only." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13.5;fontColor=#2b3444;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1120" height="60" as="geometry"/></mxCell><mxCell id="defrule" value="" style="rounded=0;whiteSpace=wrap;html=1;arcSize=6;fillColor=#8A94A6;strokeColor=#8A94A6;strokeWidth=1.6;fontColor=#8A94A6;fontSize=13;verticalAlign=top;align=center;spacingTop=6;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="1120" height="2" as="geometry"/></mxCell><mxCell id="def0" value="&lt;b&gt;Site:&lt;/b&gt; one regional deployment, addressed by a single base URL, that can host one or many instances." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12.8;fontColor=#2b3444;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="1120" height="20" as="geometry"/></mxCell><mxCell id="def1" value="&lt;b&gt;Instance:&lt;/b&gt; a logically isolated tenant — cannot see or touch another instance’s data, configuration, or users." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12.8;fontColor=#2b3444;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="1120" height="20" as="geometry"/></mxCell><mxCell id="def2" value="&lt;b&gt;Organization:&lt;/b&gt; an entity (business unit or trading partner) within an instance that owns its own connections, flows, and keys." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12.8;fontColor=#2b3444;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="1120" height="20" as="geometry"/></mxCell><mxCell id="def3" value="&lt;b&gt;Endpoints / Users / Machine users:&lt;/b&gt; an org’s connection points, human accounts, and service accounts — each scoped to that organization only." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12.8;fontColor=#2b3444;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1120" height="20" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#12123A;strokeWidth=1.6;endArrow=classic;endFill=1;" edge="1" parent="1" source="finance" target="org"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>